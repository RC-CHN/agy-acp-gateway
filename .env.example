# Required for Compose. Supply your own value here or in the shell.
GATEWAY_API_KEY=
GATEWAY_DASHBOARD=true
GATEWAY_CREDENTIAL_MODE=managed
GATEWAY_AUTH_KEEPALIVE_INTERVAL=30m
GATEWAY_STATUS_OBSERVER=frida
# Reuse an existing named volume when changing Compose project names.
# AGY_DATA_VOLUME=your_existing_agy-data

# Optional. Use an address reachable from the build and running container.
# HTTPS_PROXY=http://proxy.example:3128
# HTTP_PROXY=http://proxy.example:3128
# ALL_PROXY=socks5://proxy.example:1080
# NO_PROXY=.internal.example,localhost,127.0.0.1,::1

# Optional release checks. SHA-256 is for the ELF on the target architecture.
# AGY_EXPECTED_VERSION=1.5.14
# AGY_EXPECTED_SHA256=37873b8062391b6202a3d3199ec012abc9e53aab720d26cd65699441497d8c94
